  "query": "select h.id as \"id: HandshakeId\", a.name, o.slug\n             from handshakes h\n             join apps a on a.id = h.app_id and a.deleted_at is null\n             join orgs o on o.id = a.org_id and o.deleted_at is null\n            where h.state_sha256 = $1 and h.expires_at > now()",
