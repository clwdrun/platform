  "query": "select a.id, a.org_id, a.name, a.runtime, a.created_at, a.deleted_at\n           from apps a\n           join orgs o on o.id = a.org_id\n           where o.slug = $1 and o.deleted_at is null\n             and a.name = $2 and a.deleted_at is null",
