  "db_name": "PostgreSQL",
  "query": "select seq, ts, source, stream, request_id, text, code, runtime_code,\n                          hint, status, latency_ms\n                     from app_logs\n                    where app_id = $1\n                      and ($2::text is null or request_id = $2)\n                      and ($3::float8 is null or ts > now() - make_interval(secs => $3))\n                    order by seq desc\n                    limit $4",
